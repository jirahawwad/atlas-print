<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Atlas.Print</RootNamespace>
		<AssemblyName>Atlas.Print</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Configurations>Debug;Release;LOCAL;DEV;DEMO;QA;PROD</Configurations>
		<Version>1.0.1</Version>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="publish\**" />
		<Content Remove="publish\**" />
		<EmbeddedResource Remove="publish\**" />
		<None Remove="publish\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
		<PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="3.1.0" />
		<PackageReference Include="Serilog.Enrichers.Process" Version="2.0.2" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.9.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.9.0" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Properties\PublishProfiles\" />
	</ItemGroup>

	<Choose>
		<When Condition="'$(Configuration)' == 'LOCAL'">
			<ItemGroup>
				<!-- Exclude DEMO, DEV, QA and PROD overrides -->
				<Content Remove="appsettings.DEV.json" />
				<Content Remove="appsettings.DEMO.json" />
				<Content Remove="appsettings.QA.json" />
				<Content Remove="appsettings.PROD.json" />
			</ItemGroup>
		</When>
		<When Condition="'$(Configuration)' == 'DEMO'">
			<ItemGroup>
				<!-- Exclude DEV, QA and PROD overrides -->
				<Content Remove="appsettings.DEV.json" />
				<Content Remove="appsettings.QA.json" />
				<Content Remove="appsettings.PROD.json" />
			</ItemGroup>
		</When>
		<When Condition="'$(Configuration)' == 'DEV'">
			<ItemGroup>
				<!-- Exclude DEMO, QA and PROD overrides -->
				<Content Remove="appsettings.DEMO.json" />
				<Content Remove="appsettings.QA.json" />
				<Content Remove="appsettings.PROD.json" />
			</ItemGroup>
		</When>
		<When Condition="'$(Configuration)' == 'QA'">
			<ItemGroup>
				<!-- Exclude DEMO, DEV  and PROD overrides  -->
				<Content Remove="appsettings.DEMO.json" />
				<Content Remove="appsettings.DEV.json" />
				<Content Remove="appsettings.PROD.json" />
			</ItemGroup>
		</When>
		<When Condition="'$(Configuration)' == 'PROD'">
			<ItemGroup>
				<!-- Exclude QA overrides  -->
				<Content Remove="appsettings.DEMO.json" />
				<Content Remove="appsettings.DEV.json" />
				<Content Remove="appsettings.QA.json" />
			</ItemGroup>
		</When>
	</Choose>

	<!-- Custom Inline C# Task to handle Zip and SHA256 together without PowerShell -->
	<UsingTask TaskName="CreateStructuredZipAndHash" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<SourceDirectory ParameterType="System.String" Required="true" />
			<DestinationZip ParameterType="System.String" Required="true" />
			<Hash ParameterType="System.String" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.IO.Compression" />
			<Using Namespace="System.Security.Cryptography" />
			<Code Type="Fragment" Language="cs">
				<![CDATA[
				// Create the ZIP archive including the root directory name itself
				ZipFile.CreateFromDirectory(SourceDirectory, DestinationZip, CompressionLevel.Optimal, includeBaseDirectory: true);
				
				// Calculate the SHA256 hash of the generated ZIP file
				using (var stream = File.OpenRead(DestinationZip))
				using (var sha = SHA256.Create())
				{
					var hashBytes = sha.ComputeHash(stream);
					Hash = BitConverter.ToString(hashBytes).Replace("-", "").ToLowerInvariant();
				}
				]]>
			</Code>
		</Task>
	</UsingTask>

	<!-- The Optimized, Native Publish Target -->
	<Target Name="ZipPublishFolder" AfterTargets="AfterPublish">
		<PropertyGroup>
			<!-- Favor the profile's PublishUrl if it exists, otherwise fall back to PublishDir -->
			<ActualPublishDir Condition="'$(PublishUrl)' != ''">$(PublishUrl)</ActualPublishDir>
			<ActualPublishDir Condition="'$(PublishUrl)' == ''">$(PublishDir)</ActualPublishDir>
			<!-- Clean trailing slashes so Path.GetDirectoryName behaves consistently -->
			<CleanPublishDir>$(ActualPublishDir.TrimEnd('\').TrimEnd('/'))</CleanPublishDir>

			<!-- Get the Environment Dir (e.g., bin\Release\net8.0\publish\dev\) -->
			<EnvDir>$([System.IO.Path]::GetDirectoryName('$(CleanPublishDir)'))</EnvDir>
			<EnvDir>$([MSBuild]::EnsureTrailingSlash('$(EnvDir)'))</EnvDir>

			<!-- Get the Top-Level Publish Dir (e.g., bin\Release\net8.0\publish\) -->
			<TopPublishDir>$([System.IO.Path]::GetDirectoryName($(EnvDir.TrimEnd('\').TrimEnd('/'))))</TopPublishDir>
			<TopPublishDir>$([MSBuild]::EnsureTrailingSlash('$(TopPublishDir)'))</TopPublishDir>

			<!-- Set output paths into the top-level publish directory -->
			<ZipFile>$(TopPublishDir)$(Configuration)-$(Version).zip</ZipFile>
			<MetadataFile>$(TopPublishDir)$(Configuration)-$(Version)-metadata.txt</MetadataFile>
		</PropertyGroup>

		<!-- 1. Delete old zip and metadata if they exist in the top-level folder -->
		<Delete Files="$(ZipFile)" Condition="Exists('$(ZipFile)')" />
		<Delete Files="$(MetadataFile)" Condition="Exists('$(MetadataFile)')" />

		<!-- 2. Create the ZIP (including the version folder) and get its SHA256 hash -->
		<CreateStructuredZipAndHash SourceDirectory="$(CleanPublishDir)" DestinationZip="$(ZipFile)">
			<Output TaskParameter="Hash" PropertyName="ZipHash" />
		</CreateStructuredZipAndHash>

		<!-- 3. Generate Metadata File natively in the top-level folder -->
		<ItemGroup>
			<MetadataLines Include="Configuration: $(Configuration)" />
			<MetadataLines Include="Version: $(Version)" />
			<MetadataLines Include="BuildTimestampUtc: $([System.DateTime]::UtcNow.ToString('o'))" />
			<MetadataLines Include="ZipFile: $(Configuration)-$(Version).zip" />
			<MetadataLines Include="SHA256: $(ZipHash)" />
		</ItemGroup>

		<WriteLinesToFile File="$(MetadataFile)" Lines="@(MetadataLines)" Overwrite="true" />

		<!-- 4. Clean up ONLY the inner version folder, leaving dev/qa/demo folders intact -->
		<RemoveDir Directories="$(ActualPublishDir)" />

		<Message Importance="high" Text="[ZipPublishFolder] Success! Created '$(Configuration)-$(Version).zip' containing the root version folder. Cleaned up source files." />
	</Target>



</Project>