<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Atlas.Print</RootNamespace>
		<AssemblyName>Atlas.Print</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Configurations>Debug;Release;LOCAL;DEV;DEMO;QA;PROD</Configurations>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="publish\**" />
		<Content Remove="publish\**" />
		<EmbeddedResource Remove="publish\**" />
		<None Remove="publish\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
		<PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="3.1.0" />
		<PackageReference Include="Serilog.Enrichers.Process" Version="2.0.2" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.9.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.9.0" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Properties\PublishProfiles\" />
	</ItemGroup>

	<Choose>
		<When Condition="'$(Configuration)' == 'LOCAL'">
			<ItemGroup>
				<!-- Exclude DEMO, DEV, QA and PROD overrides -->
				<Content Remove="appsettings.DEV.json" />
				<Content Remove="appsettings.DEMO.json" />
				<Content Remove="appsettings.QA.json" />
				<Content Remove="appsettings.PROD.json" />
			</ItemGroup>
		</When>
		<When Condition="'$(Configuration)' == 'DEMO'">
			<ItemGroup>
				<!-- Exclude DEV, QA and PROD overrides -->
				<Content Remove="appsettings.DEV.json" />
				<Content Remove="appsettings.QA.json" />
				<Content Remove="appsettings.PROD.json" />
			</ItemGroup>
		</When>
		<When Condition="'$(Configuration)' == 'DEV'">
			<ItemGroup>
				<!-- Exclude DEMO, QA and PROD overrides -->
				<Content Remove="appsettings.DEMO.json" />
				<Content Remove="appsettings.QA.json" />
				<Content Remove="appsettings.PROD.json" />
			</ItemGroup>
		</When>
		<When Condition="'$(Configuration)' == 'QA'">
			<ItemGroup>
				<!-- Exclude DEMO, DEV  and PROD overrides  -->
				<Content Remove="appsettings.DEMO.json" />
				<Content Remove="appsettings.DEV.json" />
				<Content Remove="appsettings.PROD.json" />
			</ItemGroup>
		</When>
		<When Condition="'$(Configuration)' == 'PROD'">
			<ItemGroup>
				<!-- Exclude QA overrides  -->
				<Content Remove="appsettings.DEMO.json" />
				<Content Remove="appsettings.DEV.json" />
				<Content Remove="appsettings.QA.json" />
			</ItemGroup>
		</When>
	</Choose>

</Project>